# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Base URL of this app (used to build email confirmation redirect links)
SITE_URL=http://localhost:3000

# Paddle — must be "sandbox" or "production". No default: the app fails to
# start if either is missing or misspelled, so it can never run against the
# wrong Paddle account by accident.
PADDLE_ENV=sandbox
NEXT_PUBLIC_PADDLE_ENV=sandbox

# Server-side Paddle API key (Paddle > Developer tools > Authentication >
# API keys). Sandbox keys look like pdl_sdbx_apikey_...; never expose this
# to client code.
PADDLE_API_KEY=your-paddle-api-key

# Client-side token (Paddle > Developer tools > Authentication > Client-side
# tokens). Sandbox tokens are prefixed test_, live tokens live_.
NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=test_your-client-side-token

# Price ID for the club subscription (Paddle > Catalog > Prices).
NEXT_PUBLIC_PADDLE_PRICE_ID=pri_your-price-id

# Webhook signing secret (Paddle > Developer tools > Notifications > your
# webhook destination).
PADDLE_WEBHOOK_SECRET=your-webhook-secret

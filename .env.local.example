# Supabase project settings (Project Settings > API in the Supabase dashboard)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role key (Project Settings > API). Bypasses row-level security —
# only ever used server-side (e.g. the Paddle webhook handler), never
# exposed to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Base URL of this app, used server-side to build auth redirect/callback
# links. Use http://localhost:3000 for local development. No NEXT_PUBLIC_
# prefix: it's only ever read in server actions, never in the browser.
SITE_URL=http://localhost:3000

# Resend (resend.com/api-keys) — sends the "your account is confirmed"
# welcome email after a member clicks their confirmation link. EMAIL_FROM
# must be an address on a domain verified in Resend (their onboarding@
# resend.dev test address works before you've verified your own domain).
RESEND_API_KEY=
EMAIL_FROM=BookApricity <onboarding@resend.dev>

# Paddle (Developer Tools > Authentication in the Paddle dashboard)
# "sandbox" or "production" — must match where the API key/price ID below
# were created.
PADDLE_ENV=sandbox
# Same value, exposed to the browser for Paddle.js's checkout overlay.
NEXT_PUBLIC_PADDLE_ENV=sandbox
PADDLE_API_KEY=
NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=
# Price ID for the club's monthly subscription plan (Catalog > Products).
NEXT_PUBLIC_PADDLE_PRICE_ID=
# From Developer Tools > Notifications, after registering the
# /api/webhooks/paddle endpoint as a notification destination.
PADDLE_WEBHOOK_SECRET=
